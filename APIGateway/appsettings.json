{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ReverseProxy": {
        "Routes": {
            "pedidos-rota": {
                "ClusterId": "pedidos-cluster",
                "Match": {
                    "Path": "pedidos/{**catch-all}"
                },
                "Transforms": [
                    {
                        "PathPattern": "{**catch-all}"
                    }
                ]
            }
        },
        "Clusters": {
            "pedidos-cluster": {
                "Destinations": {
                    "maquinal": {
                        "Address": "http://pedidos.api:8080"
                    }
                }
            }
        }
    }
}
